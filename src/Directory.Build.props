<Project>
    <PropertyGroup>        
        <TargetFramework>net10.0</TargetFramework>

        <PackageId>Sdl3Sharp.Ttf</PackageId>
        <VersionPrefix>0.0.1</VersionPrefix>
        <VersionSuffix>alpha.2</VersionSuffix>
        <Description>SDL3#'s SDL TTF bindings</Description>
        <Authors>Felix Rüdiger</Authors>

        <PackageProjectUrl>https://github.com/Sdl3Sharp/Sdl3Sharp</PackageProjectUrl>
        <PackageTags>sdl;sdl3;sdl3sharp;sdl3#;ttf;sdl_ttf</PackageTags>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- -->

        <Sdl3SharpVersion>0.0.2-alpha.3</Sdl3SharpVersion>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="" />
    </ItemGroup>
</Project>